2. Nested List

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Nested List</title>
</head>
<body>
    <h1 style="text-align: center;">My Subjects</h1>
    <ul>
        <li><b>Front End</b>
            <ol type="i">
                <li>HTML</li>
                <li>CSS</li>
                <li>Javascript</li>
            </ol>
        </li>
        <li><b>Back End</b>
        <ol type="A">
            <li>Java</li>
            <li>Python</li>
            <li>PHP</li>
        </ol>
    </li>
    </ul>
    </body>
</html>
